# ==============================================================================
# NEXORA - Configuration des variables d'environnement
# ==============================================================================

# Serveur & Environnement
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Base de données PostgreSQL dédiée
# Remplacer <VOTRE_MOT_DE_PASSE> par le mot de passe de votre utilisateur postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexora?schema=public"

# Sécurité des Sessions (Argon2id & Cookies)
SESSION_SECRET="nexora_super_secret_session_key_min_32_characters_long_123456"
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"

# Chiffrement AES-256-GCM des secrets numériques (clé de 32 octets / 64 caractères hexadécimaux)
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Paramètres Métier par défaut
DEFAULT_CURRENCY="FCFA"
DEFAULT_TIMEZONE="Africa/Dakar"
DEFAULT_LANGUAGE="fr"
