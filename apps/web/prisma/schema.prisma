// ==============================================================================
// NEXORA - Schéma de Données PostgreSQL (Prisma ORM)
// Conforme au Cahier des charges v1.0
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// 1. Paramètres de l'Entreprise & Profil Métier (Modularité)
// ------------------------------------------------------------------------------
model CompanySettings {
  id                String   @id @default(uuid())
  businessName      String   @default("Entreprise Demo")
  legalName         String?
  logoUrl           String?
  phone             String?
  email             String?
  address           String?
  taxId             String?  // NIF / RCCM
  currency          String   @default("FCFA")
  timezone          String   @default("Africa/Dakar")
  language          String   @default("fr")
  defaultVatRate    Decimal  @default(18.0) @db.Decimal(5, 2)

  // Feature Flags de modularité selon le type d'activité
  businessType      String   @default("HYBRID") // "RETAIL", "DIGITAL_SERVICES", "CONSULTING", "HYBRID"
  enableInventory   Boolean  @default(true)
  enableDigitalSubs Boolean  @default(true)
  enablePurchases   Boolean  @default(true)
  enableQuotes      Boolean  @default(true)

  // Numérotation documentaire
  invoicePrefix     String   @default("FAC-")
  quotePrefix       String   @default("DEV-")
  creditNotePrefix  String   @default("AV-")
  purchasePrefix    String   @default("ACH-")
  paymentPrefix     String   @default("OP-")

  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// ------------------------------------------------------------------------------
// 2. Utilisateurs, Sessions & Permissions
// ------------------------------------------------------------------------------
enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  passwordHash    String           // Hachage Argon2id
  role            UserRole         @default(EMPLOYEE)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sessions        UserSession[]
  permissions     UserPermission[]
  sales           Sale[]
  payments        Payment[]
  expenses        Expense[]
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]
  monthlyClosings MonthlyClosing[]
}

model UserSession {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // Ex: "SALES_CREATE", "SUBSCRIPTION_SECRETS_READ"
  description String
  category    String           // "COMMERCE", "FINANCE", "STOCKS", "ADMINISTRATION"
  createdAt   DateTime         @default(now())

  users       UserPermission[]
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

// ------------------------------------------------------------------------------
// 3. Tiers : Clients & Fournisseurs
// ------------------------------------------------------------------------------
model Customer {
  id                 String                   @id @default(uuid())
  name               String
  phone              String?
  email              String?
  address            String?
  taxId              String?
  notes              String?
  outstandingBalance Decimal                  @default(0) @db.Decimal(15, 2) // Solde dû en FCFA
  active             Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  sales              Sale[]
  quotes             Quote[]
  creditNotes        CreditNote[]
  subscriptions      SubscriptionAssignment[]
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  purchases      PurchaseOrder[]
  expenses       Expense[]
}

// ------------------------------------------------------------------------------
// 4. Catalogue : Produits & Services
// ------------------------------------------------------------------------------
enum ItemType {
  PHYSICAL_PRODUCT
  DIGITAL_SERVICE
  CONSULTING_SERVICE
}

model Product {
  id             String          @id @default(uuid())
  sku            String          @unique
  name           String
  description    String?
  category       String
  type           ItemType        @default(PHYSICAL_PRODUCT)
  purchasePrice  Decimal         @default(0) @db.Decimal(15, 2)
  sellingPrice   Decimal         @default(0) @db.Decimal(15, 2)
  stockQuantity  Decimal         @default(0) @db.Decimal(12, 2)
  alertThreshold Decimal         @default(5) @db.Decimal(12, 2)
  unit           String          @default("unité")
  barcode        String?         @unique
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  quoteItems     QuoteItem[]
  stockMovements StockMovement[]
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  PURCHASE
  RETURN
}

model StockMovement {
  id          String            @id @default(uuid())
  productId   String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 2)
  reason      String
  reference   String?           // Ex: VTE-..., ACH-...
  userId      String
  createdAt   DateTime          @default(now())

  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([productId])
}

// ------------------------------------------------------------------------------
// 5. Abonnements & Services Numériques (Sécurisés AES-256-GCM)
// ------------------------------------------------------------------------------
model DigitalService {
  id          String           @id @default(uuid())
  name        String           // Ex: "Canva Pro", "Netflix UHD", "Pack Cloud Office"
  description String?
  category    String           @default("Licence logicielle")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  accounts    DigitalAccount[]
  saleItems   SaleItem[]
}

model DigitalAccount {
  id                   String                   @id @default(uuid())
  serviceId            String
  profileName          String?                  // Ex: "Profil 1 - PIN 4590"
  accountIdentifier    String                   // Login ou email du compte
  encryptedCredentials String                   // Chiffré en AES-256-GCM (JSON avec pass, PIN, etc.)
  encryptionVersion    String                   @default("AES-256-GCM-v1")
  isAssigned           Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  service              DigitalService           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assignments          SubscriptionAssignment[]

  @@index([serviceId])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
}

model SubscriptionAssignment {
  id             String             @id @default(uuid())
  customerId     String
  accountId      String
  startDate      DateTime
  endDate        DateTime
  durationMonths Int                @default(1)
  sellingPrice   Decimal            @default(0) @db.Decimal(15, 2)
  status         SubscriptionStatus @default(ACTIVE)
  autoRenew      Boolean            @default(false)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  account        DigitalAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([accountId])
}

// ------------------------------------------------------------------------------
// 6. Commerce : Ventes, Lignes & Facturation
// ------------------------------------------------------------------------------
enum SaleStatus {
  BROUILLON
  CONFIRMEE
  PARTIELLEMENT_PAYEE
  PAYEE
  ANNULEE
}

model Sale {
  id               String       @id @default(uuid())
  reference        String       @unique // Ex: "VTE-2025-0482"
  invoiceNumber    String?      @unique // Ex: "FAC-2025-0382"
  customerId       String
  subtotalHT       Decimal      @default(0) @db.Decimal(15, 2)
  taxAmount        Decimal      @default(0) @db.Decimal(15, 2)
  discountAmount   Decimal      @default(0) @db.Decimal(15, 2)
  totalTTC         Decimal      @default(0) @db.Decimal(15, 2)
  paidAmount       Decimal      @default(0) @db.Decimal(15, 2)
  remainingBalance Decimal      @default(0) @db.Decimal(15, 2)
  status           SaleStatus   @default(CONFIRMEE)
  notes            String?
  userId           String
  dueDate          DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  items            SaleItem[]
  payments         Payment[]
  refunds          Refund[]
  creditNotes      CreditNote[]

  @@index([customerId])
  @@index([status])
}

model SaleItem {
  id               String          @id @default(uuid())
  saleId           String
  productId        String?
  digitalServiceId String?
  productName      String          // Snapshot du nom au moment de la vente
  quantity         Decimal         @default(1) @db.Decimal(12, 2)
  unitPrice        Decimal         @db.Decimal(15, 2) // Snapshot du prix
  discount         Decimal         @default(0) @db.Decimal(5, 2)
  taxRate          Decimal         @default(18.0) @db.Decimal(5, 2)
  totalHT          Decimal         @db.Decimal(15, 2)
  totalTTC         Decimal         @db.Decimal(15, 2)

  sale             Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  digitalService   DigitalService? @relation(fields: [digitalServiceId], references: [id], onDelete: SetNull)

  @@index([saleId])
}

// ------------------------------------------------------------------------------
// 7. Finance : Paiements, Remboursements, Avoirs & Dépenses
// ------------------------------------------------------------------------------
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  MOBILE_MONEY
  OTHER
}

model Payment {
  id               String        @id @default(uuid())
  reference        String        @unique // Ex: "OP-0894"
  saleId           String?
  amount           Decimal       @db.Decimal(15, 2)
  method           PaymentMethod @default(CASH)
  paymentProofRef  String?       // Référence du bordereau / transaction
  notes            String?
  userId           String
  paidAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())

  sale             Sale?         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([userId])
}

model Refund {
  id               String       @id @default(uuid())
  reference        String       @unique
  saleId           String
  amount           Decimal      @db.Decimal(15, 2)
  reason           String
  creditNoteId     String?      @unique
  userId           String
  createdAt        DateTime     @default(now())

  sale             Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  creditNote       CreditNote?  @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)

  @@index([saleId])
}

model CreditNote {
  id          String   @id @default(uuid())
  reference   String   @unique // Ex: "AV-2025-0012"
  saleId      String
  customerId  String
  amount      Decimal  @db.Decimal(15, 2)
  reason      String
  createdAt   DateTime @default(now())

  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  refund      Refund?

  @@index([saleId])
  @@index([customerId])
}

model Expense {
  id               String        @id @default(uuid())
  reference        String        @unique // Ex: "OP-0893"
  category         String        // "Loyer bureau", "Fournitures", "Logiciel", etc.
  supplierId       String?
  description      String
  amount           Decimal       @db.Decimal(15, 2)
  method           PaymentMethod @default(CASH)
  receiptReference String?
  expenseDate      DateTime      @default(now())
  userId           String
  createdAt        DateTime      @default(now())

  supplier         Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([userId])
}

// ------------------------------------------------------------------------------
// 8. Documents Commerciaux : Devis & Commandes Fournisseurs
// ------------------------------------------------------------------------------
enum QuoteStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
  CONVERTI
}

model Quote {
  id              String      @id @default(uuid())
  reference       String      @unique // Ex: "DEV-2025-0154"
  customerId      String
  totalTTC        Decimal     @default(0) @db.Decimal(15, 2)
  status          QuoteStatus @default(BROUILLON)
  validUntil      DateTime
  convertedSaleId String?     @unique
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           QuoteItem[]

  @@index([customerId])
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String
  productId   String?
  productName String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(15, 2)
  total       Decimal  @db.Decimal(15, 2)

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

enum PurchaseStatus {
  BROUILLON
  COMMANDE
  RECEPTIONNE_PARTIEL
  RECEPTIONNE
  ANNULE
}

model PurchaseOrder {
  id           String         @id @default(uuid())
  reference    String         @unique // Ex: "ACH-2025-0128"
  supplierId   String
  totalAmount  Decimal        @default(0) @db.Decimal(15, 2)
  status       PurchaseStatus @default(COMMANDE)
  orderDate    DateTime       @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items        PurchaseItem[]

  @@index([supplierId])
}

model PurchaseItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  productId        String
  productName      String
  quantityOrdered  Decimal       @db.Decimal(12, 2)
  quantityReceived Decimal       @default(0) @db.Decimal(12, 2)
  unitPrice        Decimal       @db.Decimal(15, 2)
  total            Decimal       @db.Decimal(15, 2)

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
}

// ------------------------------------------------------------------------------
// 9. Clôtures Mensuelles, Audit & Notifications
// ------------------------------------------------------------------------------
model MonthlyClosing {
  id               String   @id @default(uuid())
  year             Int
  month            Int
  revenue          Decimal  @db.Decimal(15, 2)
  receipts         Decimal  @db.Decimal(15, 2)
  refunds          Decimal  @db.Decimal(15, 2)
  expenses         Decimal  @db.Decimal(15, 2)
  purchases        Decimal  @db.Decimal(15, 2)
  outstandingDebts Decimal  @db.Decimal(15, 2)
  isLocked         Boolean  @default(true)
  closedAt         DateTime @default(now())
  closedByUserId   String

  closedByUser     User     @relation(fields: [closedByUserId], references: [id], onDelete: Restrict)

  @@unique([year, month])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  userId    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id            String   @id @default(uuid())
  type          String   // "STOCK_ALERT", "OVERDUE_INVOICE", "SUBSCRIPTION_EXPIRING", "PAYMENT_RECEIVED", "SECURITY"
  title         String
  message       String
  read          Boolean  @default(false)
  referenceLink String?
  createdAt     DateTime @default(now())
}
